{
  "name": "101-detailers",
  "main": "./src/index.js",
  "compatibility_date": "2026-09-15",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "send_email": [
    {
      "name": "QUOTE_EMAIL",
      "destination_address": "rebsquared@gmail.com",
      "allowed_sender_addresses": ["info@101detailers.com"]
    }
  ],
  "analytics_engine_datasets": [
    {
      "binding": "CONVERSIONS",
      "dataset": "detailers_conversions"
    }
  ]
}
